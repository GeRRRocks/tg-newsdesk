# Токен бота от @BotFather
BOT_TOKEN=

# Ключ Anthropic API (console.anthropic.com)
ANTHROPIC_API_KEY=

# chat_id администраторов через запятую — каждому приходят черновики на
# модерацию, каждый может управлять источниками (/add_source и т.д.)
# (свой chat_id можно узнать через @userinfobot или /start в личке с ботом и логи;
# ВАЖНО: если пишешь боту в группу не от личного аккаунта, а от анонимного
# админа или бизнес-аккаунта, узнавать нужно именно тот id, с которого реально
# будут отправляться команды)
ADMIN_CHAT_IDS=111111111,222222222

# chat_id целевой группы (форум с включёнными Topics)
TARGET_GROUP_CHAT_ID=

# message_thread_id топика "Новости" внутри группы (см. команду /get_topic_id)
TARGET_TOPIC_ID=

# Строка подключения к PostgreSQL через asyncpg
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tg_news_bot

# Таймзона для APScheduler (IANA name)
TIMEZONE=Europe/Moscow

# Как часто (в минутах) планировщик собирает новость и генерирует черновик
# (можно поменять позже прямо из меню бота — «⏱ Расписание», без перезапуска)
DRAFT_INTERVAL_MINUTES=60

# Тематика канала — вставляется в системный промпт Claude при рерайте новости.
# Источники (RSS/HTML) тематически нейтральны, так что смена темы + источников
# превращает бота в канал про что угодно, не только про авто.
BOT_TOPIC=автомобильные новости

# --- Docker Compose ---
# Учётные данные контейнера с PostgreSQL. При запуске через docker compose
# бот подключается к сервису "db" с этими значениями, а DATABASE_URL выше
# игнорируется. Пароль сгенерируй сам: openssl rand -hex 24
POSTGRES_USER=tg_news_bot
POSTGRES_PASSWORD=
POSTGRES_DB=tg_news_bot
