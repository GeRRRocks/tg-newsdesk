# Токен бота от @BotFather
BOT_TOKEN=

# Какая нейросеть переписывает новости в посты по умолчанию:
#   anthropic — Claude   (ключ: console.anthropic.com)
#   openai    — GPT      (ключ: platform.openai.com)
#   gemini    — Gemini   (ключ: aistudio.google.com)
#   deepseek  — DeepSeek (ключ: platform.deepseek.com)
AI_PROVIDER=anthropic

# Обязателен ключ выбранного провайдера. Если вписать ещё и другие — между
# этими нейросетями можно переключаться кнопкой «🤖 Нейросеть» в меню бота
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Модель для провайдера из AI_PROVIDER. Пусто — модель по умолчанию
# (claude-opus-5 / gpt-5.4-mini / gemini-3.8-flash / deepseek-flash)
AI_MODEL=

# chat_id администраторов через запятую — каждому приходят черновики на
# модерацию, каждый может управлять источниками (/add_source и т.д.)
# (свой chat_id можно узнать через @userinfobot или /start в личке с ботом и логи;
# ВАЖНО: если пишешь боту в группу не от личного аккаунта, а от анонимного
# админа или бизнес-аккаунта, узнавать нужно именно тот id, с которого реально
# будут отправляться команды)
ADMIN_CHAT_IDS=111111111,222222222

# chat_id целевой группы (форум с включёнными Topics)
TARGET_GROUP_CHAT_ID=

# message_thread_id топика "Новости" внутри группы (см. команду /get_topic_id)
TARGET_TOPIC_ID=

# Строка подключения к PostgreSQL через asyncpg
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tg_news_bot

# Таймзона для APScheduler (IANA name)
TIMEZONE=Europe/Moscow

# Как часто (в минутах) планировщик собирает новость и генерирует черновик
# (можно поменять позже прямо из меню бота — «⏱ Расписание», без перезапуска)
DRAFT_INTERVAL_MINUTES=60

# Через сколько часов без ответа черновик закрывается сам (0 — никогда)
DRAFT_EXPIRE_HOURS=24

# Тематика канала — вставляется в системный промпт нейросети при рерайте новости.
# Источники (RSS/HTML) тематически нейтральны, так что смена темы + источников
# превращает бота в канал про что угодно, не только про авто.
BOT_TOPIC=автомобильные новости

# Язык бота: меню, кнопки, сообщения администраторам и промпт по умолчанию.
# ru (по умолчанию) или en. Применяется после перезапуска (make restart).
# Bot language: menus, buttons, admin messages and the default prompt. ru or en.
# Для en задай и BOT_TOPIC по-английски (например: car news) или оставь пустым.
BOT_LANGUAGE=ru

# Ответы на вопросы участников группы: сообщение с упоминанием бота и словом
# «Вопрос:» (или «Question:») в начале уходит в нейросеть, бот отвечает реплаем. Работает только в TARGET_GROUP_CHAT_ID.
# Каждый ответ — платный запрос к нейросети, поэтому выключено по умолчанию.
# Лимиты считаются за 24 часа с первого вопроса: на участника и на всех вместе.
# Админы из ADMIN_CHAT_IDS под лимиты не попадают.
QA_ENABLED=false
# Топик группы, в котором бот отвечает на вопросы (id подскажет /get_topic_id
# внутри топика). Пусто — отвечает в любом топике группы.
QA_TOPIC_ID=
QA_USER_DAILY_LIMIT=3
QA_GLOBAL_DAILY_LIMIT=50

# --- Docker Compose ---
# Учётные данные контейнера с PostgreSQL. При запуске через docker compose
# бот подключается к сервису "db" с этими значениями, а DATABASE_URL выше
# игнорируется. Пароль сгенерируй сам: openssl rand -hex 24
POSTGRES_USER=tg_news_bot
POSTGRES_PASSWORD=
POSTGRES_DB=tg_news_bot

# --- Резервные копии ---
# Контейнер backup раз в сутки снимает дамп базы в ./backups.
# Время — в таймзоне TIMEZONE; локальные копии старше BACKUP_KEEP_DAYS удаляются.
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14

# Отправка копий в S3-совместимое хранилище. Пока S3_BUCKET пуст, копии
# остаются только на сервере. S3_ENDPOINT — адрес хранилища без имени бакета,
# например https://storage.yandexcloud.net (регион ru-central1);
# для Amazon S3 — https://s3.<регион>.amazonaws.com
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Необязательная «папка» внутри бакета, со слэшем на конце: tg-news-bot/
S3_PREFIX=
